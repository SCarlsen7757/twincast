# Copy to .env and edit. Used by docker-compose.example.yml.
#   cp .env.example .env
#
# .env is gitignored -- keep the tunnel token out of the repository.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Identify yourself to Beckhoff. Their WAF rejects `curl/*` with 403 but accepts
# a self-identifying agent, so this is not optional -- and a real contact means
# they can reach you rather than simply blocking the poller.
USER_AGENT=Twincast/1.0 (+mailto:you@example.com)

# ---------------------------------------------------------------------------
# Board
# ---------------------------------------------------------------------------

# Timezone for the header clock and for the Today/Yesterday labels. Should match
# the screen's own timezone, or a late-evening release can read a day out.
TZ=Europe/Copenhagen

# Host port. The container always listens on 8080 internally.
BOARD_PORT=8080

# Which GHCR tag to run. Pin to a version (e.g. 1.0.0) for a screen you do not
# want changing under you; `latest` follows stable release tags.
IMAGE_TAG=latest

# Feed. Swap for any other Beckhoff RSS feed.
FEED_URL=https://www.beckhoff.com/english/rss/beckhoff-twincat-rss-feed.xml

# Minutes between polls. The feed advertises ttl=60; 30 is a reasonable middle
# and costs about 19 kB per poll because the origin supports gzip.
# Supported: 0.1–1440 minutes, measured after the previous poll completes.
POLL_INTERVAL_MIN=30

# Poll immediately at startup rather than waiting a full interval.
POLL_ON_START=true

# ---------------------------------------------------------------------------
# Rotation - these three are coupled to the Anthias asset duration
# ---------------------------------------------------------------------------
# Cycle length = HERO_COUNT x ROTATE_SECONDS. The defaults give 6 x 25 = 150s,
# which is exactly two cycles in a 5-minute Anthias slot, so every release gets
# identical screen time. Change these and re-check that arithmetic: a cycle
# longer than the asset duration means the last releases are never shown.

HERO_COUNT=6
RAIL_COUNT=8
ROTATE_SECONDS=25
# Counts must be integers 1–8; rotation must be integer seconds 5–300.

# How stale the data must get before the status dot turns amber.
# Supported: 1–10080 minutes; fractional values are allowed.
STALE_AFTER_MIN=120

# ---------------------------------------------------------------------------
# Cloudflare tunnel (only needed for docker-compose.example.yml)
# ---------------------------------------------------------------------------
# Zero Trust -> Networks -> Tunnels -> Create a tunnel -> copy the token.
# Route the tunnel's public hostname to  Service: HTTP  URL: board:8080
#
# WARNING: this publishes the board to the public internet. It redisplays
# Beckhoff's copyrighted feed content under an internal-use rationale, so put
# Cloudflare Access in front of the hostname before you use it:
#   Zero Trust -> Access -> Applications -> self-hosted -> your hostname
# Leave this blank if you only need LAN access -- the tunnel is behind a compose
# profile, so the board starts fine without it. Enable it explicitly with:
#   docker compose -f docker-compose.example.yml --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
