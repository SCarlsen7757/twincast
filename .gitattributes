# Prettier is configured with endOfLine: lf, but core.autocrlf=true is set
# system-wide on Windows and would otherwise check files out as CRLF, making
# `npm run format:check` -- and so `npm run check` -- fail on a fresh clone.
# eol=lf pins the working tree to match what Prettier expects.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.db  binary
*.bin binary
*.woff  binary
*.woff2 binary
